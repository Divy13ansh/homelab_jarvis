# Jarvis env — copy to .env and fill. Never commit .env.
JARVIS_ENV=production
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest-browser
OPENCLAW_GATEWAY_TOKEN=__REPLACE_ME_generate_with_openssl_rand_hex_32__
OPENCLAW_GATEWAY_PORT=18789

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://__YOUR_RESOURCE__.openai.azure.com/
AZURE_OPENAI_API_KEY=__REPLACE_ME__
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Discord (primary channel)
DISCORD_BOT_TOKEN=__REPLACE_ME__
DISCORD_GUILD_ID=__REPLACE_ME_optional__

# LiveKit Cloud (solves CGNAT/client-isolation; 10k min free)
LIVEKIT_URL=wss://__YOUR_PROJECT__.livekit.cloud
LIVEKIT_API_KEY=API__REPLACE_ME__
LIVEKIT_API_SECRET=__REPLACE_ME__
# Voice bridge → Gateway (in-container default is http://127.0.0.1:18789/v1;
# Cloud-hosted agent must use the public tunnel URL instead)
# OPENCLAW_GATEWAY_URL=https://jarvis.divy13ansh.in/v1
# Gateway /v1 only accepts agent routes (`openclaw` or `openclaw/<agentId>`),
# NOT provider model ids like azure/gpt-5.4-mini (400 otherwise).
# OPENCLAW_VOICE_MODEL=openclaw

# Spotify (see docs/music-spotify.md)
SPOTIFY_CLIENT_ID=__REPLACE_ME__
SPOTIFY_CLIENT_SECRET=__REPLACE_ME__
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# spotifyd sidecar — server speakers as a Spotify Connect device (see docs/music-server.md)
SPOTIFYD_VERSION=0.4.2
SPOTIFYD_DEVICE_NAME=jarvis-server
# ALSA device: prefer hw:0,0 (exclusive, no conversion). Avoid default/plughw
# on boxes with broken software resampling (silent output despite RUNNING PCM).
# Spotify streams 44.1kHz which hw:0,0 accepts natively.
SPOTIFYD_ALSA_DEVICE=hw:0,0
SPOTIFYD_MIXER=Master
SPOTIFYD_INITIAL_VOLUME=80
# Optional credential auth fallback (discovery via Spotify app is default):
# SPOTIFYD_USERNAME=__REPLACE_ME__
# SPOTIFYD_PASSWORD=__REPLACE_ME__

# Cloudflare Tunnel (host-wide homelab → divy13ansh.in)
# Your machine is already tunneled. Just add a Public Hostname in the
# Cloudflare Zero Trust dashboard: jarvis.divy13ansh.in → http://127.0.0.1:18789
# No per-service token needed. The following is only for sidecar mode:
# CLOUDFLARED_TUNNEL_TOKEN=__REPLACE_ME__
# CLOUDFLARED_TUNNEL_NAME=homelab

# Wake word ears (profile: wake) — always-on "hey jarvis" on server mic
# LIVEKIT_ROOM=jarvis
# LIVEKIT_EARS_IDENTITY=jarvis-ears
# WAKE_SENSITIVITY=0.5
# WAKE_IDLE_TIMEOUT=12
# MIC_ACTIVITY_RMS=400
# WAKE_MIC_DEVICE=hw:0,0
# WAKE_SPK_DEVICE=hw:0,0

# Optional self-hosted LiveKit fallback (profile: selfhosted)
# LIVEKIT_SELFHOST_URL=wss://livekit.divy13ansh.in
# TURN_SHARED_SECRET=__REPLACE_ME__

# Optional Telegram deferred
# TELEGRAM_BOT_TOKEN=__REPLACE_ME__
