{
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "lan",
    "trustedProxies": ["127.0.0.1/32", "::1/128", "172.16.0.0/12", "10.0.0.0/8"],
    "controlUi": {
      "allowedOrigins": [
        "http://localhost:18789",
        "http://127.0.0.1:18789",
        "https://jarvis.divy13ansh.in"
      ]
    },
    "auth": {
      "mode": "token",
      "token": {
        "source": "env",
        "provider": "default",
        "id": "OPENCLAW_GATEWAY_TOKEN"
      }
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true
        }
      }
    }
  },
  "models": {
    "providers": {
      "azure": {
        "baseUrl": "${AZURE_OPENAI_ENDPOINT}openai/v1",
        "apiKey": {
          "source": "env",
          "provider": "default",
          "id": "AZURE_OPENAI_API_KEY"
        },
        "api": "openai-completions",
        "models": [
          {
            "id": "gpt-4o",
            "name": "gpt-4o",
            "contextWindow": 128000,
            "maxTokens": 16384
          },
          {
            "id": "gpt-4o-mini",
            "name": "gpt-4o-mini",
            "contextWindow": 128000,
            "maxTokens": 16384
          },
          {
            "id": "gpt-5.4-mini",
            "name": "gpt-5.4-mini",
            "contextWindow": 400000,
            "maxTokens": 16384
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": "azure/${AZURE_OPENAI_DEPLOYMENT}",
      "sandbox": {
        "mode": "off",
        "backend": "docker",
        "scope": "session",
        "workspaceAccess": "rw",
        "docker": {
          "image": "openclaw-sandbox:bookworm-slim",
          "network": "none",
          "readOnlyRoot": true,
          "capDrop": ["ALL"]
        }
      }
    }
  },
  "tools": {
    "profile": "coding",
    "alsoAllow": ["message"]
  },
  "channels": {
    "discord": {
      "enabled": true,
      "token": {
        "source": "env",
        "provider": "default",
        "id": "DISCORD_BOT_TOKEN"
      },
      "dmPolicy": "pairing",
      "groupPolicy": "allowlist"
    }
  },
  "plugins": {
    "entries": {
      "discord": {
        "enabled": true
      }
    }
  }
}
